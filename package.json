{
  "name": "ar-io-marketplace-process",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/bundle-marketplace-process.ts",
    "test": "yarn format:fix && yarn test:unit && yarn test:integration",
    "test:unit": "rm -rf coverage && mkdir -p coverage && echo '=== Running busted tests ===' && busted . && luacov && echo '\n=== Coverage Report ===' && tail -20 coverage/luacov.report.out",
    "test:integration": "pnpm build && tsx --test --experimental-wasm-memory64 tests/integration/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "test:e2e:clean": "rm -f e2e-test.json && pnpm test:e2e",
    "test:e2e:setup": "tsx scripts/setup-e2e.ts",
    "test:e2e:validate": "tsx scripts/setup-e2e.ts --validate-only",
    "lint:fix": "luacheck src tests/unit && biome check --write --unsafe && eslint --fix packages/*/src",
    "lint:check": "luacheck src tests/unit && biome check --unsafe && eslint packages/*/src",
    "format:fix": "biome format --write",
    "format:check": "biome format",
    "clean": "./scripts/clean.sh",
    "spawn": "tsx scripts/spawn-marketplace-process.ts",
    "intents:list": "tsx scripts/list-intents.ts",
    "localnet:configure": "npx ao-localnet configure",
    "localnet:start": "npx ao-localnet start",
    "localnet:stop": "npx ao-localnet stop",
    "localnet:seed": "npx ao-localnet seed",
    "localnet:reset": "npx ao-localnet reset",
    "localnet:reseed": "npx ao-localnet reseed",
    "localnet:bootstrap": "tsx scripts/bootstrap-localnet.ts",
    "localnet:spawn": "npx ao-localnet spawn",
    "localnet:aos": "npx ao-localnet aos",
    "localnet:config": "tsx scripts/get-localnet-config.ts",
    "localnet:test-sdk": "tsx scripts/test-sdk-integration.ts",
    "localnet:upload-ant-module": "tsx scripts/upload-ant-module.ts"
  },
  "devDependencies": {
    "@ar.io/sdk": "^3.21.0",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.29.4",
    "@permaweb/ao-loader": "^0.0.49",
    "@permaweb/aoconnect": "^0.0.90",
    "@types/node": "^20.14.6",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.46.4",
    "arweave": "^1.15.7",
    "c8": "^10.1.3",
    "chalk": "^5.6.2",
    "changesets": "^1.0.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.25.1",
    "eslint-plugin-header": "^3.1.1",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ao-localnet": "github:atticusofsparta/ao-localnet-archive"
  }
}
